# Adapted from cheshire/target/xilinx (ETH Zurich / University of Bologna).
#
# Build the LAGD system bitstream. tclargs: <board> <proj> <ip.xci>...

# Top-level FPGA module (see hw/rtl/fpga/lagd_fpga.sv)
set top lagd_fpga

# Initialize implementation
set xilinx_root [file dirname [file dirname [file normalize [info script]]]]
source ${xilinx_root}/scripts/common.tcl
init_impl $xilinx_root $argc $argv

# Additional args provide the IP .xci files
read_ip [exec realpath {*}[lrange $argv 2 end]]

# Load constraints: project (design/timing) first, then board (pins) - cheshire order
import_files -fileset constrs_1 -norecurse ${xilinx_root}/constraints/lagd.xdc
import_files -fileset constrs_1 -norecurse ${xilinx_root}/constraints/${board}.xdc

# Load RTL sources (generated by bender)
source ${xilinx_root}/scripts/add_sources.${board}.tcl

# Set top module
set_property top ${top} [current_fileset]
update_compile_order -fileset sources_1

# Synthesis properties
set_property XPM_LIBRARIES XPM_MEMORY [current_project]
set_property strategy Flow_PerfOptimized_high [get_runs synth_1]

# Elaborate to explore all clocks
synth_design -rtl -name rtl_1
report_clocks -file ${project_root}/clocks.rpt

# Synthesis
launch_runs -jobs $num_jobs synth_1
wait_on_run synth_1
open_run synth_1
gen_reports ${project_root}/reports.synth

# Instantiate debug core and ILAs (no-op unless nets are MARK_DEBUG)
insert_ilas {soc_clk}

# Optional early stop after synthesis (set by `make synth`). Lets you check
# utilization/timing before the FMC pin assignments are known (implementation
# needs every port pinned; synthesis does not).
if { [info exists ::env(LAGD_STOP_AFTER_SYNTH)] && $::env(LAGD_STOP_AFTER_SYNTH) } {
    puts "LAGD: stopping after synthesis (LAGD_STOP_AFTER_SYNTH set). See reports.synth."
    return
}

# Implementation
set_property strategy Performance_ExtraTimingOpt [get_runs impl_1]
launch_runs -jobs $num_jobs impl_1 -to_step write_bitstream
wait_on_run impl_1
open_run impl_1
gen_reports ${project_root}/reports.impl

# Check timing constraints
set trep [report_timing_summary -no_header -no_detailed_paths -return_string]
if { ![string match -nocase {*timing constraints are met*} $trep] } {
    puts "Warning: Timing constraints not met for ${proj} on ${board}."
}

# Copy out final bitstream (and probe file if an ILA was inserted)
file mkdir ${xilinx_root}/out
file copy -force ${project_root}/${proj}.runs/impl_1/${top}.bit \
    ${xilinx_root}/out/${proj}.${board}.bit
set ltx ${project_root}/${proj}.runs/impl_1/${top}.ltx
if { [file exists $ltx] } {
    file copy -force $ltx ${xilinx_root}/out/${proj}.${board}.ltx
}
